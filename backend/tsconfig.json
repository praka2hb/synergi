{
  "compilerOptions": {
    // Target Node.js (required for Vercel serverless runtime)
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "CommonJS",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Node module resolution (required for @vercel/node)
    "moduleResolution": "node",
    "esModuleInterop": true,
    "outDir": "dist",

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}